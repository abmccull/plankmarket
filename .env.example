# ===========================================
# PlankMarket Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Database (Supabase PostgreSQL) ---
# Runtime traffic should use the provider pooler/transaction endpoint.
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-us-west-1.pooler.supabase.com:6543/postgres
# Schema checks and migrations should use a direct connection, not the pooler.
DATABASE_MIGRATION_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# Keep deployable environments conservative unless a measured need justifies more.
DATABASE_POOL_MAX=1

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Keep tax disabled until counsel selects the liability owner. The reference
# records that separate decision; tax codes must be explicitly approved.
STRIPE_TAX_MODE=disabled
STRIPE_TAX_POLICY_VERSION=1
STRIPE_TAX_LEGAL_DECISION_ACKNOWLEDGED=false
STRIPE_TAX_LEGAL_DECISION_REFERENCE=
STRIPE_TAX_SHIPPING_TAX_CODE=
STRIPE_TAX_BUYER_FEE_TREATMENT=undecided
STRIPE_TAX_BUYER_FEE_TAX_CODE=

# --- Uploadthing ---
UPLOADTHING_TOKEN=your-uploadthing-token

# --- Resend (Email) ---
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...
EMAIL_FROM=PlankMarket <noreply@plankmarket.com>

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# --- Inngest ---
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# --- Priority1 Freight ---
PRIORITY1_API_KEY=your-priority1-api-key
# Replace with the exact provider-confirmed production document hosts. The
# production preflight intentionally rejects this placeholder.
PRIORITY1_DOCUMENT_ALLOWED_HOSTS=priority1-document-host.example.com
# Must remain false in production. Preview and local shipping tests use true.
PRIORITY1_DRY_RUN=false

# --- PostHog analytics and exception tracking ---
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=your-cron-shared-secret
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_VERIFICATION_ALLOW_DOCUMENT_EGRESS=false
VERIFICATION_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
VERIFICATION_DOC_ALLOWED_HOSTS=storage.example.com,cdn.example.com
NODE_ENV=development
